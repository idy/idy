{
  "name": "idy-website",
  "private": true,
  "type": "module",
  "workspaces": ["packages/site-sdk"],
  "scripts": {
    "build": "node scripts/build-site-sdk.mjs",
    "check:dist": "node scripts/build-site-sdk.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 tests/types/site-sdk.ts",
    "dev": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22" }
}
